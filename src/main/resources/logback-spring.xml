<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- ============================================================= -->
  <!-- Production rolling file: INFO and above                       -->
  <!-- ============================================================= -->
  <appender name="FILE_PROD" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/m9-jtproject1-library-app.log</file>

    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/m9-jtproject1-library-app-%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>

    <!-- Keep production file to INFO+ only -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>

    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ============================================================= -->
  <!-- Debug/diagnostic rolling file: TRACE and above (everything)   -->
  <!-- ============================================================= -->
  <appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/m9-jtproject1-library-app-debug.log</file>

    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/m9-jtproject1-library-app-debug-%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>14</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>

    <!-- No threshold filter: capture TRACE..ERROR -->
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ============================================================= -->
  <!-- Application package logger at TRACE                           -->
  <!-- Sends all levels to FILE_DEBUG.                               -->
  <!-- ============================================================= -->
  <logger name="m9jt.project1" level="TRACE" additivity="true">
    <appender-ref ref="FILE_DEBUG"/>
  </logger>

  <!-- ============================================================= -->
  <!-- ROOT at INFO (no console). Sends INFO+ to production file     -->
  <!-- ============================================================= -->
  <root level="INFO">
    <appender-ref ref="FILE_PROD"/>
  </root>

</configuration>